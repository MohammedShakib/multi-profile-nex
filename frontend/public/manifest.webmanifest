{
  "id": "/",
  "name": "NovoNex Profiles",
  "short_name": "NovoNex",
  "description": "Open isolated NovoNex learning profiles from one app.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#080d17",
  "theme_color": "#080d17",
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "/plane-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/plane-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon-plane.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Personal Profile",
      "short_name": "Personal",
      "url": "/proxy/p1/dashboard/",
      "icons": [
        {
          "src": "/plane-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Shared Profile",
      "short_name": "Shared",
      "url": "/proxy/p2/dashboard/",
      "icons": [
        {
          "src": "/plane-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
